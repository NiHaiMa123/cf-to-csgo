"UnlitGeneric"
{
	"$basetexture" "models/weapons/v_models/cf_tianxi/cf_fx_glitch"
	"$frame" "0"
	"$additive" "1"
	"$translucent" "1"
	"$nocull" "1"
	"$nofog" "1"
	"$color" "[0.266667 0.047059 0.647059]"
	"Proxies"
	{
		"AnimatedTexture"
		{
			"animatedTextureVar" "$basetexture"
			"animatedTextureFrameNumVar" "$frame"
			"animatedTextureFrameRate" "12"
		}
		"Sine"
		{
			"sineperiod" "2"
			"sinemin" "0.35"
			"sinemax" "1.0"
			"timeoffset" "0"
			"resultvar" "$alpha"
		}
	}
}
