	activity "ACT_VM_HITCENTER2" 1
	fadein 0.2
	fadeout 0.2
	snap
	fps 30
}

$sequence "heavy_backstab" {
	"v_knife_default_ct_anims\heavy_backstab.smd"
	activity "ACT_VM_SWINGHARD" 1
	fadein 0.2
	fadeout 0.2
	snap
	fps 30
}

$sequence "lookat01" {
	"v_knife_default_ct_anims\lookat01.smd"
	fadein 0.2
	fadeout 0.2
	fps 35
}
